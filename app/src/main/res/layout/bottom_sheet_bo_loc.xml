<?xml version="1.0" encoding="utf-8"?>
<!-- Bảng Bộ lọc: danh mục, danh mục con, giá tối đa, tình trạng (chip tạo bằng code) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/ChuTieuDe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bộ lọc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnXoaTatCa"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xoá tất cả" />
        </LinearLayout>

        <TextView
            style="@style/NhanMuc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Danh mục" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/nhomDanhMuc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvNhanDanhMucCon"
            style="@style/NhanMuc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Danh mục con" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/nhomDanhMucCon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/NhanMuc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Giá tối đa" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/nhomGia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/NhanMuc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tình trạng" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/nhomTinhTrang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnXemKetQua"
            style="@style/NutChinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
