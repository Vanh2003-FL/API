<?xml version="1.0" encoding="utf-8"?>
<!-- Tab Tài khoản (SCR-24): thông tin người dùng, số liệu, menu chức năng, đăng xuất -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen"
    android:orientation="vertical">

    <TextView
        style="@style/ChuTieuDe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:text="Tài khoản" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Khi đang xem với tư cách khách -->
            <LinearLayout
                android:id="@+id/khungKhach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_the"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/NhanMuc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bạn đang xem với tư cách khách" />

                <TextView
                    style="@style/ChuPhu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Đăng nhập để đăng tin, lưu tin và nhắn tin với người bán." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDangNhap"
                    style="@style/NutChinh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Đăng nhập" />
            </LinearLayout>

            <!-- Khi đã đăng nhập -->
            <LinearLayout
                android:id="@+id/khungTaiKhoan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp">

                        <TextView
                            android:id="@+id/tvVietTat"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_tron"
                            android:gravity="center"
                            android:textColor="@color/tren_chinh_nhat"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/anhDaiDien"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Ảnh đại diện"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/HinhTron" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHoTen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/chu"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTruong"
                            style="@style/ChuPhu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvTrangThaiHoSo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_nhan"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3 ô số liệu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_the"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tvSoDangBan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/chu" />

                    <TextView
                        android:id="@+id/tvSoDaBan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/chu" />

                    <TextView
                        android:id="@+id/tvSoDaLuu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/chu" />
                </LinearLayout>

                <!-- Menu chức năng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_the"
                    android:orientation="vertical">

                    <include android:id="@+id/hangTinNhan" layout="@layout/hang_menu" />
                    <include android:id="@+id/hangThongBao" layout="@layout/hang_menu" />
                    <include android:id="@+id/hangTinCuaToi" layout="@layout/hang_menu" />
                    <include android:id="@+id/hangDaLuu" layout="@layout/hang_menu" />
                    <include android:id="@+id/hangHoSo" layout="@layout/hang_menu" />
                </LinearLayout>

                <!-- Chỉ hiện với tài khoản quản trị -->
                <LinearLayout
                    android:id="@+id/khungQuanTri"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_the"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include android:id="@+id/hangQuanTri" layout="@layout/hang_menu" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_the"
                    android:orientation="vertical">

                    <include android:id="@+id/hangDangXuat" layout="@layout/hang_menu" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
