<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ "Gợi ý giá" ở bước 3 đăng tin: giá gợi ý, khoảng hợp lý, độ tin cậy, nguồn dữ liệu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_canh_bao"
    android:backgroundTint="@color/nen_gia"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/NhanMuc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:text="Gợi ý giá"
            app:drawableStartCompat="@drawable/ic_bulb"
            app:drawableTint="@color/gia" />

        <TextView
            android:id="@+id/tvDoTinCay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nhan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textColor="@color/tren_chinh"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGiaGoiY"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/gia"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvKhoangGia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/chu"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvNguon"
        style="@style/ChuPhu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDungGia"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Dùng giá này" />
</LinearLayout>
