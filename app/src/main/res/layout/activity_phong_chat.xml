<?xml version="1.0" encoding="utf-8"?>
<!-- Phòng chat + thanh ghim lịch hẹn (SCR-22): thanh tin đăng, thanh ghim, tin nhắn, trả lời nhanh, ô nhập -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/thanhTieuDe"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/be_mat"
        app:navigationIcon="@drawable/ic_back"
        app:subtitleTextColor="@color/chu_phu" />

    <!-- (1) Thanh tin đăng: bấm để mở chi tiết tin -->
    <LinearLayout
        android:id="@+id/thanhTin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/be_mat"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/khungAnh"
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/iconTin"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/anhTin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh món đồ"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTieuDeTin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/chu"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvGiaTin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/gia"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- (2) Thanh ghim lịch hẹn: nội dung và nút đổi theo trạng thái + vai trò (bảng 3.3.1) -->
    <LinearLayout
        android:id="@+id/thanhGhim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nen_canh_bao"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconGhim"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_cal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTieuDeGhim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/chu"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMoTaGhim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/chu"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/khungNutGhim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGhim1"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGhim2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGhim3"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- (3) Tin nhắn xen thẻ sự kiện -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dsTinNhan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp" />

    <!-- (4) Câu trả lời nhanh theo ngữ cảnh -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/nhomTraLoiNhanh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            app:singleLine="true" />
    </HorizontalScrollView>

    <!-- (5) Ô nhập -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/be_mat"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/nhapTinNhan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_nhan"
            android:hint="Nhập tin nhắn…"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:maxLines="4"
            android:minHeight="44dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnGui"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Gửi"
            android:src="@drawable/ic_send"
            app:tint="@color/chinh" />
    </LinearLayout>
</LinearLayout>
