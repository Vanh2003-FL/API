<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ sự kiện lịch hẹn (gửi yêu cầu, đổi, chốt, huỷ, đã bán...) căn giữa, không sửa/xoá được -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp">

    <LinearLayout
        android:id="@+id/khungThe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_the_su_kien"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/iconSuKien"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="1dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSuKien"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="240dp"
                android:textColor="@color/chu"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChiTiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="240dp"
                android:textColor="@color/chu"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvGio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chu_phu"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
