<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng lựa chọn có tiêu đề, dòng phụ và dấu tích (dùng cho danh sách trường) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTieuDe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chu"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvPhu"
            style="@style/ChuPhu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iconChon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="Đã chọn"
        android:src="@drawable/ic_check"
        app:tint="@color/chinh" />
</LinearLayout>
