<?xml version="1.0" encoding="utf-8"?>
<!-- Bảng "Đánh giá người bán" (SCR-28): 1–5 sao và nhận xét -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/ChuTieuDe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đánh giá người bán" />

    <TextView
        android:id="@+id/tvNguoiBan"
        style="@style/ChuPhu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <RatingBar
        android:id="@+id/thanhSao"
        style="?android:attr/ratingBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:numStars="5"
        android:progressTint="@color/gia"
        android:rating="5"
        android:stepSize="1" />

    <TextView
        android:id="@+id/tvMucSao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/chu"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/ONhap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nhận xét (tuỳ chọn)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nhapNhanXet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="200" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGui"
        style="@style/NutChinh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Gửi đánh giá" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHuy"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Để sau" />
</LinearLayout>
