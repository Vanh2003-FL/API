<?xml version="1.0" encoding="utf-8"?>
<!-- Màn Đăng tin 3 bước (SCR-13/14/15): 1. Ảnh · 2. Danh mục · 3. Thông tin & giá (kèm Gợi ý giá) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/thanhTieuDe"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_close"
        app:title="Đăng tin" />

    <!-- Thanh tiến độ các bước -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvBuoc"
            style="@style/ChuPhu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTenBuoc"
            style="@style/ChuPhu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/thanhTienDo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:max="3"
        app:trackCornerRadius="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== BƯỚC 1: ẢNH ===== -->
        <ScrollView
            android:id="@+id/buoc1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvSoAnh"
                    style="@style/NhanMuc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp" />

                <GridLayout
                    android:id="@+id/luoiAnh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:columnCount="3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_the"
                    android:drawablePadding="10dp"
                    android:padding="12dp"
                    android:text="Ảnh rõ, đủ sáng giúp tin được bấm xem nhiều hơn. Ảnh đầu tiên là ảnh bìa."
                    android:textColor="@color/chu"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/ic_bulb"
                    app:drawableTint="@color/gia" />

                <TextView
                    android:id="@+id/tvLoiAnh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cần ít nhất 1 ảnh để tiếp tục."
                    android:textColor="@color/loi" />
            </LinearLayout>
        </ScrollView>

        <!-- ===== BƯỚC 2: DANH MỤC ===== -->
        <ScrollView
            android:id="@+id/buoc2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/NhanMuc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Món đồ thuộc loại nào?"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/dsDanhMuc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- ===== BƯỚC 3: THÔNG TIN & GIÁ ===== -->
        <ScrollView
            android:id="@+id/buoc3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/noiDungBuoc3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_the"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp">

                    <TextView
                        android:id="@+id/tvDanhMucDaChon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/chu" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDoiDanhMuc"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đổi" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/oTieuDe"
                    style="@style/ONhap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Tiêu đề *"
                    app:counterEnabled="true"
                    app:counterMaxLength="80">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nhapTieuDe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLength="80" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/NhanMuc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tình trạng *" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGiaiThich"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giải thích"
                        app:icon="@drawable/ic_info" />
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/nhomTinhTrang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <!-- Trường riêng cho Sách -->
                <LinearLayout
                    android:id="@+id/khungSach"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/oMonHoc"
                        style="@style/ONhap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Môn học">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nhapMonHoc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/ONhap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Giá bìa"
                        app:suffixText="đ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nhapGiaBia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="9" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Trường riêng cho Đồ điện tử / Đồ dùng -->
                <LinearLayout
                    android:id="@+id/khungDoKhac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/ONhap"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Hãng">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/nhapHang"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/oNamMua"
                            style="@style/ONhap"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:hint="Năm mua">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/nhapNamMua"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="4" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/ONhap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Giá mua gốc"
                        app:suffixText="đ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nhapGiaGoc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="9" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Thẻ gợi ý giá -->
                <include
                    android:id="@+id/goiY"
                    layout="@layout/the_goi_y_gia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/oGia"
                    style="@style/ONhap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Giá bán *"
                    app:suffixText="đ">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nhapGia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="9" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvCanhBaoGia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_canh_bao"
                    android:padding="10dp"
                    android:textColor="@color/canh_bao"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbMienPhi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tặng miễn phí" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/oMoTa"
                    style="@style/ONhap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="Mô tả * (tối thiểu 20 ký tự)"
                    app:counterEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nhapMoTa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Nơi giao dịch -->
                <TextView
                    android:id="@+id/tvNhanNoiGiaoDich"
                    style="@style/NhanMuc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Nơi giao dịch *" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="Trường">

                    <AutoCompleteTextView
                        android:id="@+id/chonTruong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/nhomDiem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ONhap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Ghi chú hẹn, ví dụ: sau 17h các ngày trong tuần">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nhapGhiChu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbGiaoHang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Có thể giao hàng tận nơi" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/be_mat"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTiep"
            style="@style/NutChinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
