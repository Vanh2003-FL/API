<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình chính: vùng nội dung (đổi theo tab) + thanh điều hướng 5 tab ở dưới -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/khungNoiDung"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/thanhDieuHuong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/be_mat"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_dieu_huong" />
</LinearLayout>
