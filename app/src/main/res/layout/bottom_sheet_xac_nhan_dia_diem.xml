<?xml version="1.0" encoding="utf-8"?>
<!-- Bảng "Xác nhận địa điểm giao dịch" (SCR-30): bắt buộc tích xác nhận trước khi đăng -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/ChuTieuDe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Xác nhận địa điểm giao dịch" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_the"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvDiem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textColor="@color/chu"
            android:textSize="17sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_pin"
            app:drawableTint="@color/chinh" />

        <TextView
            android:id="@+id/tvTruong"
            style="@style/ChuPhu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp" />

        <TextView
            android:id="@+id/tvGhiChu"
            style="@style/ChuPhu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawablePadding="10dp"
        android:text="Người mua sẽ thấy địa điểm này và dùng làm mặc định khi đặt mua. Nên chọn nơi đông người trong khuôn viên trường."
        android:textColor="@color/chu"
        android:textSize="13sp"
        app:drawableStartCompat="@drawable/ic_bulb"
        app:drawableTint="@color/gia" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbXacNhan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tôi xác nhận có thể giao dịch tại địa điểm này" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnXacNhan"
        style="@style/NutChinh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:enabled="false"
        android:text="Xác nhận &amp; đăng tin" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDoiDiaDiem"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đổi địa điểm" />
</LinearLayout>
